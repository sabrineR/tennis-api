# Copy to .env.production on the server and restrict file access (chmod 600).
# Never reuse development credentials or commit the populated file.
DB_NAME=tennis
DB_USER=tennis
DB_PASSWORD=

# Container HTTP port and the corresponding EC2 host port.
PORT=3000
API_HTTP_PORT=3000
# Use 127.0.0.1 when a reverse proxy runs on the same host.
API_BIND_ADDRESS=0.0.0.0

# Compose fixes DB_HOST=db and DB_PORT=5432 for the private Docker network.
# DB_SSL=false applies only to this local, private PostgreSQL container.
